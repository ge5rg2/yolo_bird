# runs 폴더 내부의 모든 파일 무시
runs/segment/**
runs/detect/** 
# log 파일 무시
runs/logs/**

# raw_data 폴더 내부의 모든 파일 무시
raw_data/images/**
raw_data/labels/**

# datasets/bird_v1 내부의 train, val, test 폴더 내 파일 무시
datasets/bird_v1/train/images/**
datasets/bird_v1/train/labels/**
datasets/bird_v1/val/images/**
datasets/bird_v1/val/labels/**
datasets/bird_v1/test/images/**
datasets/bird_v1/test/labels/**
datasets/bird_v2/train/images/**
datasets/bird_v2/train/labels/**
datasets/bird_v2/val/images/**
datasets/bird_v2/val/labels/**
datasets/bird_v2/test/images/**
datasets/bird_v2/test/labels/**


# 확장자가 .a인 파일 무시
#*.a

# 윗 라인에서 확장자가 .a인 파일은 무시하게 했지만 lib.a는 무시하지 않음
#!lib.a

# 현재 디렉터리에 있는 TODO 파일은 무시하고 subdir/TODO 처럼
# 하위 디렉터리에 있는 파일은 무시하지 않음
#/TODO

# build/ 디렉터리에 있는 모든 파일 무시
#build/

# doc/notes.txt 파일은 무시하고 doc/server/arch.txt 파일은 무시하지 않음
#doc/*.txt

# doc 디렉터리 아래의 모든 .pdf 파일을 무시
#doc/**/*.pdf
